# Klaviyo server-side waitlist subscription and contact-form event tracking
# Private key scopes: events:write, profiles:write, lists:write, subscriptions:write
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_WAITLIST_LIST_ID=
KLAVIYO_API_REVISION=2026-07-15

# Shopify Admin customer sync (requires write_customers)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2026-07
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
