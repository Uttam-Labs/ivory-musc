# Public storefront URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shopify Headless / Storefront API
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07
SHOPIFY_REVALIDATION_SECRET=replace-with-a-long-random-value

# Shopify Admin API (server-only; used to store contact enquiries as Metaobjects)
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2026-07
SHOPIFY_CONTACT_METAOBJECT_TYPE=contact_enquiry

# Contact email delivery (server-only; Nodemailer / SMTP)
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Existing project naming supported by the contact mailer
NODEMAILER_EMAIL=
NODEMAILER_APP_PASSWORD=
# Optional aliases: use these instead of NODEMAILER_* if preferred
SMTP_USER=
SMTP_PASSWORD=
SMTP_CREDENTIAL_ENCRYPTION_KEY=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_SUBJECT_PREFIX=Ivory Muse website enquiry

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-01
SANITY_API_READ_TOKEN=
SANITY_REVALIDATION_SECRET=replace-with-a-different-long-random-value

# Figma design source (keep the token server-only)
FIGMA_FILE_URL=https://www.figma.com/design/your-file-key/your-file-name
FIGMA_ACCESS_TOKEN=
